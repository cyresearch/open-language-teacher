# 复制本文件为 .env 再填空（或直接跑 python3 setup/birth.py 让出生仪式代劳）。
# .env 已被 gitignore，密钥永不入库。

# ---- 大脑（三通道，见 SECURITY.md「合规的大脑接入」）----
BRAIN_PROVIDER=claude-code  # claude-code | api | ollama
CLAUDE_BIN=                 # 留空 = 自动找 (which claude)
CLAUDE_MODEL=sonnet         # 值班员用的模型（claude-code 通道）
DESKTOP_CLAUDE_MODEL=haiku  # 电脑课用的模型（面对面求快）
ANTHROPIC_API_KEY=          # BRAIN_PROVIDER=api 时必填
ANTHROPIC_MODEL=claude-opus-4-8   # api 通道模型（求省换 claude-sonnet-5 / claude-haiku-4-5）
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3          # BRAIN_PROVIDER=ollama 时用

# ---- Discord 值班员 ----
DISCORD_BOT_TOKEN=          # Discord 开发者后台 → Bot → Reset Token
DISCORD_CHANNEL_ID=         # 你和老师的频道 ID（开发者模式右键复制）
DISCORD_OWNER_ID=           # 你自己的用户 ID（老师只应答这个人）
TEACHER_NAME=先生           # 回信里显示的老师名字

# ---- 居住地时区（老师据此判断早晚问候，给 lessons 打时间戳）----
TIMEZONE=                   # IANA 名（Asia/Tokyo / America/New_York / Europe/London 等）；留空=跟随系统时区

# ---- 夜谈 / 早间新闻 ----
NIGHTLY_TIME=21:00          # 老师每晚主动来找你的时间（services.py 用它排定时器）
MORNING_TIME=09:00          # 早间新闻：老师现查当天新闻用学习语言讲给你听（留空=不要；领域在 config/morning-news.md）

# ---- 语音引擎 ----
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_RUN=               # VOICEVOX 引擎可执行文件路径（留空 = 不自动拉起）
KOKORO_DIR=~/.local/opt/kokoro   # kokoro-v1.0.onnx 和 voices-v1.0.bin 所在目录
WHISPER_REPO=mlx-community/whisper-large-v3-turbo
EDGE_TTS_BIN=               # 留空 = 自动找 (which edge-tts)
